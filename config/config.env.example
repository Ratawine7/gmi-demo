PORT=9000
NODE_ENV=production

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gmi

# Legacy secret accepted by admin-only endpoints via the `x-admin-key` header
ADMIN_API_KEY=replace-with-a-strong-admin-key

# Strong secret used to sign admin login sessions
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Used once by `npm run admin:create` to create or rotate the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=GMI Admin

# Allowed frontend origins for authenticated API calls, comma-separated
CORS_ORIGIN=http://localhost:3000,https://your-production-domain.com

# Base URL the Next.js frontend uses to reach this Express API
NEXT_PUBLIC_API_URL=http://localhost:9000/api/v1

# Google reCAPTCHA keys
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-google-site-key
RECAPTCHA_SECRET_KEY=your-google-secret-key
RECAPTCHA_ENABLE_IN_DEV=false
