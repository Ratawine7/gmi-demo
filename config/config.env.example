PORT=9000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gmi

# Legacy secret accepted by admin-only endpoints via the `x-admin-key` header
ADMIN_API_KEY=change-me

# Strong secret used to sign admin login sessions
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# Used once by `npm run admin:create` to create or rotate the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=GMI Admin

# Allowed frontend origins for authenticated API calls, comma-separated
CORS_ORIGIN=http://localhost:3000

# Base URL the Next.js frontend uses to reach this Express API
NEXT_PUBLIC_API_URL=http://localhost:9000/api/v1
