{
  "name": "gmi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"next dev\" \"tsx watch server.ts\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server.ts",
    "build": "next build",
    "start": "concurrently -n web,api -c cyan,magenta \"next start\" \"NODE_ENV=production tsx server.ts\"",
    "start:web": "next start",
    "start:api": "NODE_ENV=production tsx server.ts",
    "db:test": "tsx scripts/testDb.ts",
    "admin:create": "tsx scripts/createAdmin.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.21.0",
    "mongoose": "^9.9.4",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
